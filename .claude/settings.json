{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run lint:ci)",
      "Bash(bun run lint:fsd)",
      "Bash(bun run format)",
      "Bash(bun run type-check)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run build)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(aws *)",
      "Read(./.env.prod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-human-only.sh"
          }
        ]
      }
    ]
  }
}
